NODE_ENV=development
PORT=3000
# 反向代理层数（Nginx 一层填 1），用于正确识别客户端 IP
TRUST_PROXY=0
# 管理后台令牌（生产环境必填，未填则 /admin 接口全部禁用）
ADMIN_TOKEN=replace-with-a-long-random-token
# PostgreSQL（当前仅建表，服务端使用内存存储）
DATABASE_URL=postgres://user:password@127.0.0.1:5432/life_copy_factory

# ---- 风控阈值 ----
RISK_NEW_ACCOUNT_HOURS=24
RISK_NEW_ACCOUNT_HOURLY=3
RISK_NEW_ACCOUNT_DAILY=10
RISK_NORMAL_HOURLY=20
RISK_NORMAL_DAILY=60
RISK_IP_PER_MINUTE=5
RISK_DUPLICATE_MINUTES=5
RISK_DAILY_TOTAL_LIMIT=5000

# ---- 第三方服务 Key（仅后端，后台“服务配置与用量”页可见是否已配置）----
LLM_API_KEY=
MODERATION_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=
TTS_API_KEY=
ASR_API_KEY=
